generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth Required Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  bookings      Booking[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Booking {
  id              String   @id @default(uuid())
  name            String
  phone           String
  eventType       String
  date            DateTime
  timeSlot        String   @default("09:00 AM")
  location        String
  requirements    String?
  packageId       String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Photo {
  id        String   @id @default(uuid())
  url       String
  category  String
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Promo {
  id        String   @id @default(uuid())
  code      String   @unique
  discount  Float
  type      String   // percentage | fixed
  active    Boolean  @default(true)
  uses      Int      @default(0)
  createdAt DateTime @default(now())
}

model Frame {
  id           String   @id @default(uuid())
  size         String   @unique
  width        Int
  height       Int
  price        String
  numericPrice Int
  bestFor      String
  tag          String?
  popular      Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteAsset {
  id        String   @id @default(uuid())
  key       String   @unique
  url       String
  meta      Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  event     String
  text      String
  rating    Int      @default(5)
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
}

model Package {
  id          String   @id @default(uuid())
  name        String
  price       String
  description String
  features    String[]
  popular     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Order {
  id            String   @id @default(uuid())
  orderId       String   @unique
  customerName  String
  customerPhone String
  address       String
  items         Json
  totalAmount   Float
  status        String   @default("PENDING")
  courierTrackingId String?
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  razorpaySignature String?
  createdAt     DateTime @default(now())

  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Product {
  id             String   @id @default(uuid())
  name           String
  price          Float
  category       String
  image          String
  hasCustomPhoto Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model ChatCache {
  id              String   @id @default(uuid())
  normalizedQuery String   @unique
  category        String   @default("GENERAL")
  botReply        Json
  hitCount        Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChatLog {
  id         String   @id @default(uuid())
  sessionId  String?
  userPrompt String
  botReply   String
  language   String   @default("en")
  wasCached  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ClientGallery {
  id            String         @id @default(uuid())
  slug          String         @unique
  clientName    String
  clientPhone   String
  passcode      String
  eventDate     DateTime
  maxSelections Int            @default(40)
  status        String         @default("OPEN") // OPEN, SUBMITTED, PRINTING, DELIVERED
  photos        GalleryPhoto[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model GalleryPhoto {
  id         String        @id @default(uuid())
  galleryId  String
  gallery    ClientGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  url        String
  filename   String
  isSelected Boolean       @default(false)
  comment    String?
  createdAt  DateTime      @default(now())
}

model BookedSlot {
  id        String   @id @default(uuid())
  date      DateTime
  timeSlot  String   // e.g. "09:00 AM", "02:00 PM", "FULL_DAY"
  bookingId String?
  createdAt DateTime @default(now())
}
