generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Booking {
  id              String   @id @default(uuid())
  name            String
  phone           String
  eventType       String
  date            DateTime
  location        String
  requirements    String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

model Photo {
  id        String   @id @default(uuid())
  url       String
  category  String
  createdAt DateTime @default(now())
}
