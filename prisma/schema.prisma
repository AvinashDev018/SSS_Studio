generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Booking {
  id              String   @id @default(uuid())
  name            String
  phone           String
  eventType       String
  date            DateTime
  location        String
  requirements    String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

model Photo {
  id        String   @id @default(uuid())
  url       String
  category  String
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  event     String
  text      String
  rating    Int      @default(5)
  createdAt DateTime @default(now())
}

model Package {
  id          String   @id @default(uuid())
  name        String
  price       String
  description String
  features    String[]
  popular     Boolean  @default(false)
  createdAt   DateTime @default(now())
}
